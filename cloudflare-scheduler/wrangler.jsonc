{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tv-keyword-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "triggers": {
    "crons": [
      "30 21 * * *",
      "30 3 * * *"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "fddcddhdd",
    "GITHUB_REPO": "tv-keyword",
    "GITHUB_WORKFLOW": "update-tv.yml",
    "GITHUB_REF": "main"
  }
}
